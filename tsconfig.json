{
  // Extends the WXT-generated config so auto-import globals (defineBackground,
  // etc.) and WXT path aliases are typed. Keep in sync with .wxt/tsconfig.json.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@background/*": ["./src/background/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": ["src/**/*", "wxt.config.ts", ".wxt/wxt.d.ts"],
  "exclude": [".output"]
}
